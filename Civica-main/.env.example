GOOGLE_API_KEY=
OPENAI_API_KEY=

CIVICA_TEXT_PROVIDER=google
CIVICA_MULTIMODAL_PROVIDER=google
CIVICA_CHAT_PROVIDER=google
CIVICA_TEXT_MODEL=gemini-3.6-flash
CIVICA_MULTIMODAL_MODEL=gemini-3.6-flash
CIVICA_CHAT_MODEL=gemini-3.6-flash
CIVICA_OPENAI_REASONING_MODEL=o3

# Optional provider fallback for non-grounded text/chat requests.
# Example: use OpenAI when Gemini is rate-limited or out of quota.
CIVICA_FALLBACK_PROVIDER=
CIVICA_FALLBACK_MODEL=

CIVICA_MAX_UPLOAD_MB=10
CIVICA_REQUEST_TIMEOUT=15

# Application-level protection against provider bursts/quota exhaustion.
CIVICA_LLM_RPM=8
CIVICA_LLM_MAX_CONCURRENCY=2
CIVICA_LLM_MAX_RETRIES=2
CIVICA_LLM_BACKOFF_INITIAL=1.0
CIVICA_LLM_BACKOFF_MAX=8.0
CIVICA_LLM_CACHE_TTL=20
CIVICA_LLM_CIRCUIT_OPEN=120

CIVICA_CORS_ORIGINS=http://localhost:8000
